{
    "name": "strukt/tasker",
    "description": "A typed, testable PHP task runner and project CLI for Strukt.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "strukt/event": "dev-main",
        "strukt/fs": "dev-main",
        "strukt/process": "dev-main"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../strukt4/base",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/base": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../../strukt4/event",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/event": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../../strukt4/fs",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/fs": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../process",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/process": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../../strukt4/console",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/console": "dev-main"
                }
            }
        }
    ],
    "scripts": {
        "test": "pest"
    },
    "bin": [
        "bin/tasker"
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ]
}